APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
DATABASE_URL=postgresql+psycopg://localhost:5432/buyer_agent
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Default local mode. It runs the complete seeded workflow without an API key.
AI_MODE=replay

# Optional live Gemini mode. Replace AI_MODE above with "live", then uncomment
# these three lines and paste your own key. Never commit the key.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=replace-with-your-gemini-api-key
