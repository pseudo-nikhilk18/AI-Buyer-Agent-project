APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
DATABASE_URL=postgresql+psycopg://localhost:5432/buyer_agent
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# The product uses a live model. Choose one provider block and add your own key.
# Keep unused provider blocks commented. Never commit backend/.env.
AI_MODE=live

# Gemini — default, suitable for a free Google AI Studio key
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# OpenAI alternative — replace the three Gemini lines above with:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# Anthropic alternative — replace the three Gemini lines above with:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=

# Use AI_MODE=replay only for the deterministic system/safety regression.
