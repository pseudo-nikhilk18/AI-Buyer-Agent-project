APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
DATABASE_URL=postgresql+psycopg://localhost:5432/buyer_agent
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# The product uses a live model. Add your own key; never commit it.
AI_MODE=live
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Use AI_MODE=replay only for the deterministic system/safety regression.
